{
  "format_version": 1,
  "id": "library-act1",
  "hypothesis": "A policy trained only on starter decks in weak fights improves on held-out real Act 1 loadouts, including regular and elite fights, when trained on reconstructed loadouts from completed runs, without losing weak-fight play.",
  "training": {
    "train_on": "seeds",
    "actors": 5,
    "envs": 2,
    "episodes": 240,
    "lr": 0.0003,
    "epochs": 3,
    "minibatch": 512,
    "clip": 0.2,
    "lam": 0.95,
    "vf": 0.5,
    "ent": 0.01,
    "d": 128,
    "layers": 3,
    "max_lag": 2,
    "bucket": true,
    "amp": "none",
    "eval_every": 10,
    "eval_sampled": 20,
    "eval_prefix": "EVAL",
    "pool": "library",
    "reward": "hp",
    "turn_cost_hp": 0.05,
    "hours": 0.3333333333333333,
    "eval_seeds": 10,
    "extend_vocab": true
  },
  "required_inputs": [
    "init_from",
    "pool_file"
  ],
  "comparison": {
    "baseline": "initial transferred snapshot",
    "seed_prefix": "LIBRARY-FINAL-NEW",
    "seeds": 10,
    "split": "test"
  }
}
